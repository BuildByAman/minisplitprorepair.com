---
layout: layout.njk
pagination:
  data: services
  size: 1
  alias: service
permalink: "services/{{ service.slug }}/index.html"
eleventyComputed:
  title: "{{ service.title }} | Mini Split Repair & Service | Mini Split Pro Repair"
  description: "Expert {{ service.title | lower }} near you. Call {{ site.PHONE }} for 24/7 same-day emergency mini split repair, diagnostics, and certified ductless service."
  canonical: "{{ site.DOMAIN }}/services/{{ service.slug }}/"
---

{# ── Breadcrumb ────────────────────────────────────────────────────────── #}
<div class="breadcrumb-bar">
  <div class="container">
    <div class="bc-inner" id="svcBreadcrumb">
      <i class="ph ph-house" style="font-size:13px"></i>
      <a href="/">Home</a>
      <span class="bc-sep">›</span>
      <a href="/services/">Our Services</a>
      <span class="bc-sep">›</span>
      <span>{{ service.title }}</span>
    </div>
  </div>
</div>

{# ── Banner ────────────────────────────────────────────────────────────── #}
<div class="rs-banner">
  <div class="container">
    <div class="banner-row">
      <div class="banner-content-col">
        <div class="banner-content">
          <div class="sub-label">
            <i class="ph ph-snowflake" style="font-size:12px"></i>
            Certified Ductless HVAC Specialists
          </div>
          <h1 class="title">
            {{ service.title }} <span id="svcLocationSpan">Near You</span>
          </h1>
          <p class="description" id="svcBannerDesc">
            {{ service.description }} At {{ site.BRAND }}, our certified HVAC technicians are standing by 24/7 for
            expert mini split repair, precision system diagnostics, and same-day mini split service.
          </p>
          <div class="btn-part">
            <a class="readon orange" href="{{ site.PHONE_HREF }}">
              <i class="ph ph-phone-call" style="font-size:17px"></i>
              {{ site.PHONE }} · Call For Service
            </a>
          </div>
        </div>
      </div>
      <div class="banner-img-box">
        <img src="/images/{{ service.image }}" alt="{{ service.title }} by certified local HVAC technicians near you. Call {{ site.BRAND }} for same-day ductless mini split repair." width="580" height="400" loading="eager" fetchpriority="high">
      </div>
    </div>
  </div>
</div>

{# ── Content ───────────────────────────────────────────────────────────── #}
<div class="rs-choose" style="background:var(--gray-bg)">
  <div class="container">
    <div class="choose-grid">
      <div>
        <div class="sec-title4">
          <div class="sub-line"></div>
          <span class="sub-text">
            <i class="ph ph-info" style="font-size:13px"></i>
            Specialized Service Overview
          </span>
          <h2>Expert {{ service.title }} <span id="svcLocH2">Near You</span></h2>
          <p>
            When your home or business requires dependable {{ service.title | lower }} near you,
            {{ site.BRAND }} delivers industry-leading ductless HVAC craftsmanship and rapid mini split repair. Ductless
            glitches and error codes can quickly escalate into severe compressor or inverter failure if left unaddressed. Explore all of our
            <a href="/services/" id="svcAllLink" style="color:var(--primary);text-decoration:underline">professional mini split services</a>.
          </p>
          <p>
            Our licensed technicians utilize digital manifold diagnostic analyzers, electronic leak sensors, and carry
            OEM replacement parts for all major manufacturers (Mitsubishi, Daikin, Fujitsu, LG, Gree, and more) to fix your system on the first visit. We offer transparent upfront
            flat-rate pricing with zero hidden fees, and back all our work with a 100% satisfaction guarantee.
          </p>
          <div style="margin-top:26px">
            <a class="readon orange" href="{{ site.PHONE_HREF }}">
              <i class="ph ph-phone-call" style="font-size:17px"></i>
              {{ site.PHONE }} · Book Service Now
            </a>
          </div>
        </div>
      </div>
      <div class="choose-img">
        <img src="/images/{{ service.image }}" alt="Professional {{ service.title }} company near you. Certified HVAC technicians providing top-rated mini split repair." width="580" height="400" loading="lazy">
      </div>
    </div>
  </div>
</div>

{# ── CTA Strip ─────────────────────────────────────────────────────────── #}
<div class="cta-strip">
  <div class="container">
    <h2 id="svcCtaH2">Need Professional {{ service.title }} Near You?</h2>
    <p>Don't let climate issues disrupt your comfort. Our certified local HVAC technicians are available 24/7 for emergency mini split repair and same-day service.</p>
    <a class="readon orange" href="{{ site.PHONE_HREF }}">
      <i class="ph ph-phone-call" style="font-size:18px"></i>
      {{ site.PHONE }} — Speak With A Ductless Expert
    </a>
  </div>
</div>

{# ── Client-Side Location Detection ───────────────────────────────────── #}
<script>
(function () {
  var SVC_TITLE = {{ service.title | jsonld | safe }};
  var SVC_DESC  = {{ service.description | jsonld | safe }};

  var userLocStr = localStorage.getItem('userLoc');
  if (!userLocStr) return;

  var loc;
  try {
    loc = JSON.parse(userLocStr);
  } catch (e) {
    return;
  }

  var locText = 'in ' + loc.stateName;
  if (loc.cityName) {
    locText = 'in ' + loc.cityName + ', ' + loc.stateAbbr;
  }

  // h1 span
  var locSpan = document.getElementById('svcLocationSpan');
  if (locSpan) locSpan.textContent = locText;

  // h2 in content
  var locH2 = document.getElementById('svcLocH2');
  if (locH2) locH2.textContent = locText;

  // Banner description — replace "near you" with location
  var desc = document.getElementById('svcBannerDesc');
  if (desc) {
    var newDesc = SVC_DESC.replace(/near you/gi, locText.toLowerCase());
    desc.textContent = newDesc + ' At {{ site.BRAND }}, our certified HVAC technicians are standing by for same-day mini split repair and 24/7 emergency service.';
  }

  // CTA h2
  var ctaH2 = document.getElementById('svcCtaH2');
  if (ctaH2) ctaH2.textContent = 'Need ' + SVC_TITLE + ' ' + locText + '?';

  // All services link (keep clean URL)
  var allLink = document.getElementById('svcAllLink');
  if (allLink) allLink.setAttribute('href', '/services/');

  // Breadcrumb
  var bc = document.getElementById('svcBreadcrumb');
  if (bc) {
    var extra = '';
    if (loc.stateSlug) extra += '<span class="bc-sep">›</span><a href="/' + loc.stateSlug + '/">' + loc.stateName + '</a>';
    if (loc.citySlug) extra += '<span class="bc-sep">›</span><a href="/' + loc.stateSlug + '/' + loc.citySlug + '/">' + loc.cityName + '</a>';
    bc.innerHTML = '<i class="ph ph-house" style="font-size:13px"></i>'
      + '<a href="/">Home</a>' + extra
      + '<span class="bc-sep">›</span><a href="/services/">Our Services</a>'
      + '<span class="bc-sep">›</span><span>' + SVC_TITLE + '</span>';
  }

  // Document title
  document.title = SVC_TITLE + ' ' + locText + ' | Mini Split Repair & Service | {{ site.BRAND }}';
})();
</script>
