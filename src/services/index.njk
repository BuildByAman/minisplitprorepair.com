---
layout: layout.njk
title: "Mini Split Repair & Ductless Services | Mini Split Pro Repair"
description: "Comprehensive mini split repair and 24/7 ductless service near you: emergency repair, installation, deep cleaning, refrigerant recharge & multi-zone setups. Call (877) 739-2492."
canonical: "https://minisplitprorepair.com/services/"
---

{# ── Service Icon Map ──────────────────────────────────────────────────── #}
{% set serviceIcons = {
  'emergency-mini-split-repair': 'ph-siren',
  'mini-split-installation': 'ph-wrench',
  'mini-split-repair': 'ph-gear',
  'mini-split-cleaning': 'ph-broom',
  'mini-split-refrigerant-recharge': 'ph-snowflake',
  'mini-split-not-cooling': 'ph-thermometer-cold',
  'mini-split-not-heating': 'ph-thermometer-hot',
  'multi-zone-mini-split': 'ph-house-line',
  'commercial-mini-split': 'ph-buildings',
  'mini-split-maintenance': 'ph-clipboard-text',
  'mini-split-replacement': 'ph-arrows-counter-clockwise',
  'ductless-ac-services': 'ph-wind'
} %}

{# ── Breadcrumb ────────────────────────────────────────────────────────── #}
<div class="breadcrumb-bar">
  <div class="container">
    <div class="bc-inner">
      <i class="ph ph-house" style="font-size:13px"></i>
      <a href="/">Home</a>
      <span class="bc-sep">›</span>
      <span>Our Services</span>
    </div>
  </div>
</div>

{# ── Banner ────────────────────────────────────────────────────────────── #}
<div class="rs-banner">
  <div class="container">
    <div class="banner-row">
      <div class="banner-content-col">
        <div class="banner-content">
          <div class="sub-label">
            <i class="ph ph-snowflake" style="font-size:12px"></i>
            Ductless HVAC Service Catalog
          </div>
          <h1 class="title">
            Ductless Mini Split Repair &amp; <span>HVAC Services</span>
          </h1>
          <p class="description">
            {{ site.BRAND }} delivers comprehensive solutions for single-zone and multi-zone ductless systems nationwide. 
            From 24/7 emergency mini split repair and precision installations to electronic leak detection, 
            deep coil sanitization, and preventative maintenance agreements. Connect with certified ductless specialists near you.
          </p>
          <div class="btn-part">
            <a class="readon orange" href="{{ site.PHONE_HREF }}">
              <i class="ph ph-phone-call" style="font-size:17px"></i>
              {{ site.PHONE }} · Call For Service
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{# ── Services Grid ─────────────────────────────────────────────────────── #}
<div class="rs-services">
  <div class="container">
    <h2>Specialized Ductless Mini Split Services We Provide</h2>
    <div class="services-row">
      {% for svc in services %}
      <div class="services-slider">
        <div class="services-item">
          <a href="/services/{{ svc.slug }}/" class="card-link" aria-label="View {{ svc.title }}"></a>
          <div class="services-img">
            <img src="/images/{{ svc.image }}" alt="{{ svc.title }} service by certified HVAC technician" width="400" height="250" loading="lazy" class="svc-card-img">
          </div>
          <div class="services-icon-bar">
            <div class="svc-icon">
              <i class="ph {{ serviceIcons[svc.slug] or 'ph-snowflake' }}"></i>
            </div>
          </div>
          <div class="services-content">
            <h3 class="title">
              <a href="/services/{{ svc.slug }}/">{{ svc.title }}</a>
            </h3>
            <p class="description">{{ svc.description }}</p>
            <div class="services-btn">
              <a href="{{ site.PHONE_HREF }}">
                <span class="btn-text">Request Service</span>
                <span class="arrow-icon">
                  <i class="ph ph-arrow-right" style="font-size:12px"></i>
                </span>
              </a>
            </div>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

{# ── CTA Strip ─────────────────────────────────────────────────────────── #}
<div class="cta-strip">
  <div class="container">
    <h2>Need Immediate Mini Split Repair? Call (877) 739-2492 Today</h2>
    <p>Our certified ductless HVAC specialists are ready 24/7 for same-day emergency mini split repair and scheduled service.</p>
    <a class="readon orange" href="{{ site.PHONE_HREF }}">
      <i class="ph ph-phone-call" style="font-size:18px"></i>
      {{ site.PHONE }} — Speak With A Specialist
    </a>
  </div>
</div>
