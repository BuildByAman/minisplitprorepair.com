---
layout: layout.njk
pagination:
  data: states
  size: 1
  alias: state
permalink: "/{{ state.slug }}/index.html"
eleventyComputed:
  title: "Mini Split Repair in {{ state.name }} | 24/7 Ductless Service"
  description: "Certified mini split repair and same day ductless service in {{ state.name }}. Emergency AC & heat pump fix, installation, cleaning & refrigerant recharge. Call {{ site.PHONE }}."
  canonical: "{{ site.DOMAIN }}/{{ state.slug }}/"
  stateSlug: "{{ state.slug }}"
---

{# ── Service Icon Map ──────────────────────────────────────────────────── #}
{% set serviceIcons = {
  'emergency-mini-split-repair': 'ph-siren',
  'mini-split-installation': 'ph-wrench',
  'mini-split-repair': 'ph-gear',
  'mini-split-cleaning': 'ph-broom',
  'mini-split-refrigerant-recharge': 'ph-snowflake',
  'mini-split-not-cooling': 'ph-thermometer-cold',
  'mini-split-not-heating': 'ph-thermometer-hot',
  'multi-zone-mini-split': 'ph-house-line',
  'commercial-mini-split': 'ph-buildings',
  'mini-split-maintenance': 'ph-clipboard-text',
  'mini-split-replacement': 'ph-arrows-counter-clockwise',
  'ductless-ac-services': 'ph-wind'
} %}

{# ── Schemas ───────────────────────────────────────────────────────────── #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "{{ site.BRAND }} - {{ state.name }}",
  "image": "{{ site.DOMAIN }}/favicon.svg",
  "url": "{{ site.DOMAIN }}/{{ state.slug }}/",
  "telephone": "{{ site.PHONE }}",
  "priceRange": "$$",
  "areaServed": {
    "@type": "State",
    "name": "{{ state.name }}"
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.DOMAIN }}/" },
    { "@type": "ListItem", "position": 2, "name": "{{ state.name }}", "item": "{{ site.DOMAIN }}/{{ state.slug }}/" }
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for faq in faqs %}
    {
      "@type": "Question",
      "name": {{ faq.q | jsonld | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ faq.a | jsonld | safe }} }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>

{# ── Breadcrumb ────────────────────────────────────────────────────────── #}
<div class="breadcrumb-bar">
  <div class="container">
    <div class="bc-inner">
      <i class="ph ph-house" style="font-size:13px"></i>
      <a href="/">Home</a>
      <span class="bc-sep">›</span>
      <span>{{ state.name }}</span>
    </div>
  </div>
</div>

{# ── Banner ────────────────────────────────────────────────────────────── #}
<div class="rs-banner">
  <div class="container">
    <div class="banner-row">
      <div class="banner-content-col">
        <div class="banner-content">
          <div class="sub-label">
            <i class="ph ph-map-pin" style="font-size:12px"></i>
            {{ state.name }} Ductless HVAC Specialists
          </div>
          <h1 class="title">
            Mini Split Repair in <span>{{ state.name }}</span> | 24/7 Service
          </h1>
          <p class="description">
            Looking for certified mini split repair in {{ state.name }}? We provide prompt 24/7 dispatch for 
            urgent ductless AC repairs, precision new installations, antibacterial cleanings, and dependable mini split service. 
            Serving {{ state.cities.length }} communities across {{ state.abbr }}.
          </p>
          <div class="btn-part">
            <a class="readon orange" href="{{ site.PHONE_HREF }}">
              <i class="ph ph-phone-call" style="font-size:17px"></i>
              {{ site.PHONE }} · Call For Service
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{# ── Counter ───────────────────────────────────────────────────────────── #}
<div class="rs-counter">
  <div class="container">
    <div class="counter-grid">
      <div class="counter-list">
        <div class="counter-text">
          <div class="counter-icon">
            <i class="ph ph-users-three" style="font-size:26px;color:#fff"></i>
          </div>
          <div class="counter-number">
            <div class="count-row"><span class="rs-count">10,000</span><span class="prefix">+</span></div>
            <div class="counter-label">Certified Technicians</div>
          </div>
        </div>
      </div>
      <div class="counter-list">
        <div class="counter-text">
          <div class="counter-icon">
            <i class="ph ph-snowflake" style="font-size:26px;color:#fff"></i>
          </div>
          <div class="counter-number">
            <div class="count-row"><span class="rs-count">250,000</span><span class="prefix">+</span></div>
            <div class="counter-label">Systems Serviced</div>
          </div>
        </div>
      </div>
      <div class="counter-list">
        <div class="counter-text">
          <div class="counter-icon">
            <i class="ph ph-star" style="font-size:26px;color:#fff"></i>
          </div>
          <div class="counter-number">
            <div class="count-row"><span class="rs-count">50,000</span><span class="prefix">+</span></div>
            <div class="counter-label">5 Star Reviews</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{# ── Services Grid ─────────────────────────────────────────────────────── #}
<div class="rs-services">
  <div class="container">
    <h2>Certified Mini Split Repair &amp; Service in {{ state.name }}</h2>
    <div class="services-row">
      {% for svc in services %}
      <div class="services-slider">
        <div class="services-item">
          <a href="/services/{{ svc.slug }}/" class="card-link" aria-label="View {{ svc.title }}"></a>
          <div class="services-img">
            <img src="/images/{{ svc.image }}" alt="{{ svc.title }} in {{ state.name }}" width="400" height="250" loading="lazy" class="svc-card-img">
          </div>
          <div class="services-icon-bar">
            <div class="svc-icon">
              <i class="ph {{ serviceIcons[svc.slug] or 'ph-snowflake' }}"></i>
            </div>
          </div>
          <div class="services-content">
            <h3 class="title">
              <a href="/services/{{ svc.slug }}/">{{ svc.title }} in {{ state.name }}</a>
            </h3>
            <p class="description">
              Looking for {{ svc.title | lower }} in {{ state.name }}? Contact {{ site.BRAND }} at
              {{ site.PHONE }} for professional ductless HVAC services. {{ svc.description.split('.')[0] }}.
            </p>
            <div class="services-btn">
              <a href="{{ site.PHONE_HREF }}">
                <span class="btn-text">Request Quote</span>
                <span class="arrow-icon">
                  <i class="ph ph-arrow-right" style="font-size:12px"></i>
                </span>
              </a>
            </div>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

{# ── Why Choose ────────────────────────────────────────────────────────── #}
<div class="rs-choose">
  <div class="container">
    <div class="choose-grid">
      <div class="choose-img">
        <img src="/images/mini-split-outdoor.webp" alt="Professional mini split HVAC technicians in {{ state.name }} equipped with diagnostic tools for ductless service." width="580" height="400" loading="lazy">
      </div>
      <div>
        <div class="sec-title4">
          <div class="sub-line"></div>
          <span class="sub-text">
            <i class="ph ph-shield-check" style="font-size:13px"></i>
            Why Choose Us
          </span>
          <h2>Certified Ductless HVAC Specialists in {{ state.name }}</h2>
          <p>{{ whyChooseContent.p1 }}</p>
          <p>{{ whyChooseContent.p2 }}</p>
          <p>{{ localClimateText }}</p>
          <div style="margin-top:26px">
            <a class="readon orange" href="{{ site.PHONE_HREF }}">
              <i class="ph ph-phone-call" style="font-size:17px"></i>
              {{ site.PHONE }} · Call For Service
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{# ── Google Map ────────────────────────────────────────────────────────── #}
<div class="rs-map">
  <div class="container">
    <div class="map-frame">
      <iframe src="https://maps.google.com/maps?q={{ state.name | urlencode }}%20USA&t=&z=7&ie=UTF8&iwloc=&output=embed" width="100%" height="360" style="border:0;display:block" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Map of {{ state.name }}"></iframe>
    </div>
  </div>
</div>

{# ── FAQ ───────────────────────────────────────────────────────────────── #}
<div class="rs-faq">
  <div class="container">
    <h2 class="faq-inner-title">
      <i class="ph ph-chat-circle-dots" style="font-size:26px;color:var(--primary);margin-right:8px;vertical-align:middle"></i>
      Frequently Asked Questions About Mini Split Repair in {{ state.name }}
    </h2>
    <div class="faq-grid">
      <div class="faq-img">
        <img src="/images/mini-split-installation.webp" alt="Frequently asked mini split questions in {{ state.name }} answered by certified technicians." width="580" height="400" loading="lazy">
      </div>
      <div class="accordion" itemscope itemtype="https://schema.org/FAQPage">
        {% for faq in faqs %}
        <div class="acc-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
          <button class="acc-question" itemprop="name" aria-expanded="{{ 'true' if loop.first else 'false' }}">
            {{ faq.q }}
            <span class="acc-icon">+</span>
          </button>
          <div class="acc-answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text">{{ faq.a }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{# ── Testimonials ──────────────────────────────────────────────────────── #}
<div class="rs-testimonial">
  <div class="container">
    <div class="sec-inner-title">
      <span class="sub-text">
        <i class="ph ph-star" style="font-size:13px"></i>
        Customer Reviews
      </span>
      <h2>What Homeowners Say About Our Service in {{ state.name }}</h2>
    </div>
    <div class="testi-grid">
      {% for t in testimonials %}
      <div class="testi-item">
        <div class="testi-stars">★★★★★</div>
        <p>"{{ t.text }}"</p>
        <div class="testi-author">
          <i class="ph ph-user-circle" style="font-size:14px;margin-right:4px"></i>
          {{ t.author }}
        </div>
        <div class="testi-loc">{{ state.name }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

{# ── Cities Grid ───────────────────────────────────────────────────────── #}
<div class="rs-addon-services">
  <div class="container">
    <h2>
      <i class="ph ph-map-trifold" style="font-size:26px;color:var(--primary);margin-right:8px;vertical-align:middle"></i>
      Find Mini Split Repair &amp; Service Across {{ state.name }} Cities
    </h2>
    <div class="addon-row">
      {% for city in state.cities %}
      <a href="/{{ state.slug }}/{{ city.slug }}/" class="addon-item" style="text-decoration:none">
        <div class="services-text">
          <div class="services-title">
            <i class="ph ph-map-pin" style="font-size:13px;color:var(--primary);flex-shrink:0"></i>
            <h3>{{ city.name }}</h3>
          </div>
          {% if city.zip or city.county %}
          <div class="location-meta">
            {% if city.zip %}<span>{{ city.zip }}</span>{% endif %}
            {% if city.county %}<span class="county"> · {{ city.county }} Co.</span>{% endif %}
          </div>
          {% endif %}
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</div>

{# ── CTA ───────────────────────────────────────────────────────────────── #}
<div class="cta-strip">
  <div class="container">
    <h2>Need Fast Mini Split Repair in {{ state.name }}? Call Now</h2>
    <p>Our certified local HVAC technicians are standing by for same day ductless service across all of {{ state.name }}.</p>
    <a class="readon orange" href="{{ site.PHONE_HREF }}">
      <i class="ph ph-phone-call" style="font-size:18px"></i>
      {{ site.PHONE }} — Call For Immediate Dispatch
    </a>
  </div>
</div>

<script>
  localStorage.setItem('userLoc', JSON.stringify({
    stateName: "{{ state.name }}",
    stateAbbr: "{{ state.abbr }}",
    stateSlug: "{{ state.slug }}"
  }));
</script>
