<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ title if title else "Mini Split Repair & 24/7 Ductless Service | Mini Split Pro Repair" }}</title>
  <meta name="description" content="{{ description if description else 'Fast, certified mini split repair and same day ductless service near you. 24/7 emergency AC & heat pump repair, installation and maintenance. Call (877) 739-2492.' }}">
  {% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="geo.region" content="US">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  {# Open Graph #}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.BRAND }}">
  <meta property="og:title" content="{{ title if title else 'Mini Split Repair & 24/7 Ductless Service | Mini Split Pro Repair' }}">
  <meta property="og:description" content="{{ description if description else 'Fast, certified mini split repair and same day ductless service near you. 24/7 emergency AC & heat pump repair, installation and maintenance. Call (877) 739-2492.' }}">
  {% if canonical %}<meta property="og:url" content="{{ canonical }}">{% endif %}
  <meta property="og:image" content="{{ site.DOMAIN }}/images/mini-split-hero.webp">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  {# Twitter Card #}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title if title else 'Mini Split Repair & 24/7 Ductless Service | Mini Split Pro Repair' }}">
  <meta name="twitter:description" content="{{ description if description else 'Fast, certified mini split repair and same day ductless service near you. 24/7 emergency AC & heat pump repair, installation and maintenance. Call (877) 739-2492.' }}">
  <meta name="twitter:image" content="{{ site.DOMAIN }}/images/mini-split-hero.webp">

  {# Fonts & Resource Preconnects #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  {# Preload LCP Hero Image for immediate discovery #}
  <link rel="preload" as="image" href="/images/mini-split-hero.webp" fetchpriority="high">

  {# Google Fonts (Poppins) - Non-render-blocking with font-display swap #}
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" media="print" onload="this.media='all'">
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap">
  </noscript>

  {# Phosphor Icons CSS Font - Non-blocking #}
  <link rel="preload" as="style" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css">
  <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css" media="print" onload="this.media='all'">
  <noscript>
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css">
  </noscript>

  {# Main Stylesheet #}
  <link rel="stylesheet" href="/css/globals.css">

  {# JSON-LD Schemas injected from page data #}
  {% if schemas %}
    {% for schema in schemas %}
      <script type="application/ld+json">{{ schema | jsonld | safe }}</script>
    {% endfor %}
  {% endif %}
</head>
<body>

